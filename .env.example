# No credentials needed for local development; inquiries save in .local/inquiries/.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
INQUIRY_STORAGE=local
# Required for deployed submissions (INQUIRY_STORAGE=supabase).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Reserved for future client authentication. Never put service keys in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Recommended production spam protection (Cloudflare Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional on non-Vercel production hosts, ONLY when the reverse proxy overwrites
# this header with the real client IP and strips any client-supplied value.
# Otherwise leave blank and use your hosting WAF's rate limiter.
TRUSTED_PROXY_IP_HEADER=
# Optional future integrations, not active in Phase 1.
EMAIL_API_KEY=
ANALYTICS_DOMAIN=
